# beta-0.3.8: separate, hardened local-only HTTPS read-only WebAdmin gateway.
# Example ONLY. TOTP is not phishing resistant and does not enable a public
# listener or Internet-facing reverse proxy. An opt-in SSH port-forward pilot
# still terminates at loopback and requires verified HTTPS on the client.
# Required modules: ssl, headers, rewrite, alias, proxy, proxy_http, authz_core,
# authz_host. Configure a trusted local certificate before use.
# Match DC24H_REMOTE_ORIGIN=https://localhost:8443 in the gateway service.
Listen 127.0.0.1:8443
ProxyRequests Off
ProxyPreserveHost Off
ProxyAddHeaders Off
TraceEnable Off

<VirtualHost 127.0.0.1:8443>
    ServerName localhost
    # Preserve suspicious doubled slashes for the exact ProxyPassMatch route check.
    # Apache otherwise collapses them before matching (MergeSlashes defaults On).
    MergeSlashes Off
    DocumentRoot "/usr/local/share/dc24h/webadmin"
    ServerSignature Off
    SSLEngine On
    SSLCertificateFile "/etc/dc24h/remote-tls/fullchain.pem"
    SSLCertificateKeyFile "/etc/dc24h/remote-tls/privkey.pem"
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    # Restrict TLS 1.2 to forward-secret AEAD suites; TLS 1.3 uses OpenSSL's
    # separate modern cipher-suite policy. Validate with a real TLS handshake.
    SSLCipherSuite "ECDHE+AESGCM:ECDHE+CHACHA20:!aNULL:!eNULL:!MD5:!3DES:!RC4"
    SSLHonorCipherOrder On
    SSLCompression Off
    SSLSessionTickets Off
    ProxyTimeout 5
    LimitRequestBody 2048

    # ProxyPreserveHost is deliberately Off: reject the ORIGINAL browser Host
    # here, before Apache substitutes its own loopback Host for Node.
    # Only the configured HTTPS origin may reach the remote portal.
    RewriteEngine On
    RewriteCond %{HTTP_HOST} !^localhost:8443$ [NC]
    RewriteRule ^ - [F,END]

    # Defense in depth at the TLS boundary, before the Node route allowlist.
    # A query string or wrong method must not reach even a mock upstream.
    RewriteCond %{REQUEST_URI} ^/remote/v1/
    RewriteCond %{QUERY_STRING} !^$
    RewriteRule ^ - [F,END]
    RewriteCond %{REQUEST_URI} ^/remote/v1/(?:challenge|session|summary|passkey/devices)$
    RewriteCond %{REQUEST_METHOD} !^GET$
    RewriteRule ^ - [F,END]
    # GET endpoints are bodyless. Do not forward a framed/streamed GET body
    # even though mod_proxy would accept the otherwise allowlisted URL.
    RewriteCond %{REQUEST_URI} ^/remote/v1/(?:challenge|session|summary|passkey/devices)$
    RewriteCond %{HTTP:Transfer-Encoding} !^$
    RewriteRule ^ - [F,END]
    RewriteCond %{REQUEST_URI} ^/remote/v1/(?:challenge|session|summary|passkey/devices)$
    RewriteCond %{HTTP:Content-Length} !^(?:0)?$
    RewriteRule ^ - [F,END]
    RewriteCond %{REQUEST_URI} ^/remote/v1/(?:login|logout|passkey/(?:login/(?:options|finish)|enroll/(?:options|finish)|device/(?:rename|revoke)))$
    RewriteCond %{REQUEST_METHOD} !^POST$
    RewriteRule ^ - [F,END]
    # mod_proxy can stream the request without applying LimitRequestBody.
    # Enforce the POST framing/size limit while the original browser headers
    # are still available at the TLS boundary, before invoking the backend.
    RewriteCond %{REQUEST_URI} ^/remote/v1/(?:login|logout|passkey/(?:login/(?:options|finish)|enroll/(?:options|finish)|device/(?:rename|revoke)))$
    RewriteCond %{HTTP:Transfer-Encoding} !^$
    RewriteRule ^ - [F,END]
    RewriteCond %{REQUEST_URI} ^/remote/v1/(?:login|logout)$
    RewriteCond %{HTTP:Content-Length} !^[0-9]{1,4}$
    RewriteRule ^ - [F,END]
    # Passkey WebAuthn responses contain bounded binary objects encoded as
    # JSON; this is a separate 32 KiB exception, not a general upload route.
    RewriteCond %{REQUEST_URI} ^/remote/v1/passkey/(?:login/(?:options|finish)|enroll/(?:options|finish)|device/(?:rename|revoke))$
    RewriteCond %{HTTP:Content-Length} !^[0-9]{1,5}$
    RewriteRule ^ - [F,END]
    RewriteCond %{REQUEST_URI} ^/remote/v1/passkey/(?:login/(?:options|finish)|enroll/(?:options|finish)|device/(?:rename|revoke))$
    RewriteCond %{HTTP:Content-Length} -gt32768
    RewriteRule ^ - [F,END]
    RewriteCond %{REQUEST_URI} ^/remote/v1/(?:login|logout)$
    RewriteCond %{HTTP:Content-Length} -gt2048
    RewriteRule ^ - [F,END]
    RewriteCond %{REQUEST_URI} ^/remote/v1/
    RewriteCond %{HTTP:Origin} !^$
    RewriteCond %{HTTP:Origin} !^https://localhost:8443$
    RewriteRule ^ - [F,END]
    # Refuse cross-site Fetch Metadata at the TLS boundary, before proxying.
    # Older/CLI clients may omit the header; Node repeats the same check.
    RewriteCond %{REQUEST_URI} ^/remote/v1/
    RewriteCond %{HTTP:Sec-Fetch-Site} !^$
    RewriteCond %{HTTP:Sec-Fetch-Site} !^(?:same-origin|none)$
    RewriteRule ^ - [F,END]
    RewriteCond %{REQUEST_URI} ^/remote/v1/(?:login|logout)$
    RewriteCond %{HTTP:Origin} !^https://localhost:8443$
    RewriteRule ^ - [F,END]

    <Directory "/usr/local/share/dc24h/webadmin">
        Options -Indexes -Includes -ExecCGI -FollowSymLinks
        AllowOverride None
        Require local
        DirectoryIndex remote.html
    </Directory>
    # The remote vhost must never serve the ordinary writable WebAdmin shell
    # or its local-only JS/CSS entrypoints from the shared Vite build.
    <Files "index.html">
        Require all denied
    </Files>
    <FilesMatch "^local-[A-Za-z0-9_-]+\.(?:js|css)$">
        Require all denied
    </FilesMatch>
    # Strip browser-supplied process credentials and proxy identity.
    # The gateway injects its own local C++ API token, never the browser.
    RequestHeader unset Authorization
    RequestHeader unset Proxy-Authorization
    RequestHeader unset X-DC24H-Admin-Grant
    RequestHeader unset X-DC24H-Session
    RequestHeader unset X-DC24H-Csrf
    RequestHeader unset Forwarded
    RequestHeader unset Proxy
    RequestHeader unset X-Forwarded-For
    RequestHeader unset X-Forwarded-Host
    RequestHeader unset X-Forwarded-Proto
    RequestHeader unset X-Forwarded-Port
    RequestHeader unset X-Forwarded-Prefix
    RequestHeader unset X-Forwarded-User
    RequestHeader unset X-Real-IP
    RequestHeader unset X-Original-URL
    RequestHeader unset X-Rewrite-URL

    # Exact read-only gateway routes. Never proxy /admin-api, /api, /management
    # or any wildcard into the existing local WebAdmin adapter.
    ProxyPassMatch "^(/remote/v1/(?:challenge|login|session|summary|logout|passkey/devices|passkey/(?:login/(?:options|finish)|enroll/(?:options|finish)|device/(?:rename|revoke))))$" "http://127.0.0.1:4182$1"
    ProxyPassReverse "/remote/v1/" "http://127.0.0.1:4182/remote/v1/"
    <LocationMatch "^/remote/v1/">
        Require local
        Header always set Cache-Control "no-store"
    </LocationMatch>
    <LocationMatch "^/remote/v1/passkey/">
        Require local
        LimitRequestBody 32768
    </LocationMatch>
    <LocationMatch "^/(?:admin-api|api|management)(?:/|$)">
        Require all denied
    </LocationMatch>
    <LocationMatch "(?:^|/)\.">
        Require all denied
    </LocationMatch>
    <FilesMatch "(?i)(^\.|\.(?:token|password|key|pem|p12|pfx|ini|conf|sql|log)(?:\.|$))">
        Require all denied
    </FilesMatch>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Cache-Control "no-store"
</VirtualHost>
